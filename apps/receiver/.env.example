# apps/receiver — copy to `.env` (Bun loads the .env in the app's own dir).
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arbitrator
AMQP_URL=amqp://arbitrator:arbitrator@localhost:5672
AMQP_EXCHANGE=arbitrator
REDIS_URL=redis://localhost:6379
# dist/index.js in a built image
RECEIVER_WORKER=src/index.ts
