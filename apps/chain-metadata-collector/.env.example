# apps/chain-metadata-collector — copy to `.env` (Bun loads the .env in the
# app's own dir).
NODE_ENV=development
LISTER_URL=http://localhost:3001

# TypeSafe/Jev — advisory `--resolve` only (legacy alias JEV_API_KEY)
TYPESAFE_API_KEY=

# Keyed venues — required only to crawl them; blank = skipped.
# binance / gate / kucoin / bitget are keyless.
MEXC_API_KEY=
MEXC_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
