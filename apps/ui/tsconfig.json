{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "esnext"
    ],
    "types": [
      "bun-types",
      "@kitajs/html/htmx.d.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@kitajs/html",
    "plugins": [
      {
        "name": "@kitajs/ts-html-plugin"
      }
    ]
  }
}
