{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": [
			"ESNext",
			"DOM"
		],
		"jsxImportSource": "@kitajs/html",
		"jsxFactory": "Html.createElement",
		"jsxFragmentFactory": "Html.Fragment",
		"plugins": [
			{
				"name": "@kitajs/ts-html-plugin"
			}
		]
	}
}
