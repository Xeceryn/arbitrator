    "@elysiajs/server-timing": "^1.4.0",
    "@elysiajs/static": "^1.4.0",
    "@faker-js/faker": "catalog:tools",
    "@gtramontina.com/elysia-htmx": "^2.0.0",
    "@kitajs/html": "^4.2.10",
    "@kitajs/ts-html-plugin": "^4.1.3",
    "@orpc/client": "catalog:core",
    "elysia": "^1.4.5",
    "htmx.org": "^2.0.7",
    "hyperscript.org": "^0.9.14",
    "lucide": "^0.544.0",
    "theme-change": "^2.5.0",
    "zod": "catalog:core"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "daisyui": "^5.1.13",
    "tailwindcss": "^4.1.13"
  }
