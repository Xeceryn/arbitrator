        "@orpc/client": "^1.8.5",
        "@orpc/server": "^1.8.5",
        "drizzle-orm": "^0.44.5",
        "drizzle-zod": "^0.8.3",
        "zod": "^4.1.3"
      },
      "tools": {
        "axios": "^1.11.0",
