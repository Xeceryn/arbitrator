{
  "$schema": "https://schemastore.org/package.json",
  "name": "arbitrator",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "core": {
        "amqplib": "^2.2.0",
        "@orpc/client": "^1.15.4",
        "@orpc/server": "^1.15.4",
        "drizzle-orm": "^0.45.3",
        "drizzle-zod": "^0.8.3",
        "zod": "^4.6.5",
        "@nats-io/transport-node": "^3.4.0",
        "pg": "^8.23.1"
      },
      "tools": {
        "axios": "^1.11.0",
        "winston": "^3.19.0",
        "drizzle-kit": "^0.31.11",
        "drizzle-seed": "^0.3.1",
        "@faker-js/faker": "^10.6.0"
      },
      "sdk": {
        "binance": "^2.15.14",
        "bitget-api": "^2.3.0",
        "bitmart-api": "^2.1.9",
        "kucoin-api": "^1.0.20",
        "gateio-api": "^1.1.3",
        "okx-api": "^1.1.3"
      },
      "types": {
        "@types/amqplib": "^0.10.7",
        "@types/bun": "^1.4.2"
      }
    }
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@types/bun": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "prettier": "3.9.9",
    "typescript-eslint": "^8.71.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@bufbuild/buf",
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild"
  ]
